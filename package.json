{
  "name": "dsh-coze-loop",
  "version": "0.1.0",
  "private": false,
  "description": "DeepSeek Harness (DSH) bundle adapter for Coze Loop.",
  "main": "./dsh/index.mjs",
  "exports": {
    ".": "./dsh/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh",
    "cordis.patch.yml",
    "release/deployment/docker-compose",
